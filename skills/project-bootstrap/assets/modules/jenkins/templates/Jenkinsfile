// @@module:github
// Pipeline Jenkins : complète .github/workflows/ci.yml (GitHub Actions) sans le remplacer.
// Mêmes contrôles que ci.yml ; étapes manuelles et limites : docs/jenkins.md.
// @@end
// @@module:gitlab
// Pipeline Jenkins : CI du projet hébergé sur GitLab (aucun .gitlab-ci.yml).
// Étapes manuelles et limites : docs/jenkins.md.
// @@end
// Agents Linux ou macOS (étapes sh). La chaîne d'outils de la stack s'installe dans scripts/jenkins-setup.sh.
pipeline {
  agent any
  options {
    timeout(time: 10, unit: 'MINUTES')
  }
  environment {
    CI = 'true'
    // @@module:openspec
    OPENSPEC_TELEMETRY = '0'
    // @@end
    // @@module:openspec|archgate
    // @@module:cli-local
    PATH = "${env.WORKSPACE}/node_modules/.bin:${env.PATH}"
    // @@end
    // @@module:cli-npm-global
    PATH = "${env.WORKSPACE}/.ci-tools/bin:${env.PATH}"
    // @@end
    // @@end
  }
  stages {
    stage('Node') {
      steps {
        sh '''
          command -v node >/dev/null || { echo "node introuvable sur l'agent (Node >= 20.19 requis)"; exit 1; }
          node -e "const v = process.versions.node.split('.').map(Number); if (v[0] < 20 || (v[0] === 20 && v[1] < 19)) { console.error('Node >= 20.19 requis, version trouvee : ' + process.versions.node); process.exit(1); }"
        '''
      }
    }
    stage('Titre de PR') {
      when { changeRequest() }
      steps {
        withEnv(["PR_TITLE=${env.CHANGE_TITLE}"]) {
          sh 'node scripts/check-pr-title.mjs'
        }
      }
    }
    // @@module:openspec|archgate
    stage("CLI d'outillage") {
      steps {
        // @@module:cli-local
        sh 'npm ci'
        // @@end
        // @@module:cli-npm-global
        sh '''
          # @@module:openspec
          npm install -g --prefix "$WORKSPACE/.ci-tools" "@fission-ai/openspec@{{OPENSPEC_VERSION}}"
          # @@end
          # @@module:archgate
          npm install -g --prefix "$WORKSPACE/.ci-tools" "archgate@{{ARCHGATE_VERSION}}"
          # @@end
        '''
        // @@end
      }
    }
    // @@end
    // @@module:openspec
    stage('OpenSpec validate') {
      steps {
        sh 'openspec validate --all --strict --no-interactive'
      }
    }
    // @@end
    // @@module:archgate
    stage('Archgate check') {
      steps {
        sh 'archgate check --output console'
      }
    }
    // @@end
    stage("Chaîne d'outils du projet") {
      steps {
        sh 'sh scripts/jenkins-setup.sh'
      }
    }
    stage('Commandes du projet') {
      steps {
        sh 'node .bootstrap/run-checks.mjs'
      }
    }
  }
}
